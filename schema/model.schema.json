{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "model.schema.json",
  "title": "Model",
  "description": "One entry per model (e.g. SAM 3). Entries are grouped for display by `family`, but never inherit from it: each carries its own cells, tiers and license.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "family",
    "cells",
    "hf_task",
    "tiers",
    "license",
    "open_weights",
    "hf_repo",
    "links",
    "feeds_into",
    "verified",
    "notes",
    "source",
    "developer",
    "summary",
    "summary_source"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Specific model or version name, e.g. 'SAM 3'."
    },
    "family": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Id of a file in data/families/. Display grouping only."
    },
    "cells": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "description": "Grid placements for THIS model: input modality column x output type row.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "input",
          "output"
        ],
        "properties": {
          "input": {
            "enum": [
              "image",
              "text",
              "audio",
              "video"
            ]
          },
          "output": {
            "enum": [
              "label",
              "embedding",
              "boxes_masks",
              "text",
              "image",
              "audio",
              "video"
            ]
          }
        }
      }
    },
    "hf_task": {
      "type": [
        "string",
        "null"
      ],
      "description": "Primary Hub pipeline tag; must exist in data/tasks.json. Null for API-only families."
    },
    "tiers": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "cpu_edge",
          "gpu_8gb",
          "gpu_24gb",
          "datacenter",
          "api"
        ]
      },
      "description": "Deployment tiers spanned by the family's variants. Empty = unknown."
    },
    "license": {
      "type": [
        "string",
        "null"
      ]
    },
    "open_weights": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "url"
        ],
        "properties": {
          "label": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          }
        }
      }
    },
    "feeds_into": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      },
      "description": "Model ids this commonly pairs with downstream."
    },
    "verified": {
      "type": "boolean",
      "description": "True only after a human checked tiers/license against sources."
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    },
    "source": {
      "enum": [
        "curated",
        "auto"
      ]
    },
    "metrics": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "default": null,
      "description": "Filled by the weekly job from the Hub API. Never hand-edited.",
      "properties": {
        "downloads_30d": {
          "type": [
            "integer",
            "null"
          ]
        },
        "likes": {
          "type": [
            "integer",
            "null"
          ]
        },
        "fetched_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    },
    "hf_repo": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[\\w.-]+/[\\w.-]+$",
      "description": "Example Hub repo (checked to exist)."
    },
    "developer": {
      "type": [
        "string",
        "null"
      ],
      "description": "Who built it: the Hub organization for open models, the provider for hosted ones. Taken from the source, never from an AI model."
    },
    "summary": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 300,
      "description": "1-2 plain sentences: what it is, what problem it solves, why it exists. No URLs or markup."
    },
    "summary_source": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "ai",
        "curated",
        null
      ],
      "description": "'ai' = summarized by an AI model from the model card (unreviewed); 'curated' = written or approved by a person."
    },
    "card_hash": {
      "type": [
        "string",
        "null"
      ],
      "description": "Hash of the sanitized card text the summary was made from; the job regenerates the summary only when it changes."
    }
  }
}
