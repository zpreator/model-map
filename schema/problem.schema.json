{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "problem.schema.json",
  "title": "Problem preset",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "steps", "note"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "title": { "type": "string", "minLength": 1 },
    "steps": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["label", "models"],
        "properties": {
          "label": { "type": "string", "minLength": 1 },
          "models": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" }, "description": "Candidate model ids." }
        }
      }
    },
    "note": { "type": ["string", "null"] }
  }
}
